{
    "version": 2,
    "builds": [
        {
            "src": "src/app.js",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "src/app.js"
        }
    ],
    "rewrites": [
        {
            "source": "/api/:path*",
            "destination": "https://ckp-harian-backend.vercel.app/api/:path*"
        }
    ]
}